{
  "info": {
    "name": "NovaMerch API - Smoke & Auth Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Automated API tests for the NovaMerch backend. Covers health, login, validation and access control - the only features implemented so far."
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Responds within 2 seconds\", () => pm.expect(pm.response.responseTime).to.be.below(2000));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Smoke",
      "item": [
        {
          "name": "TC01 - Health check is UP",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "The service is running and can reach its database."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Status is UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Login - positive",
      "item": [
        {
          "name": "TC02 - Login with valid credentials",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Happy path. Saves the token into the environment as {{accessToken}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{validEmail}}\",\n  \"password\": \"{{validPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Returns an access token\", () => pm.expect(body.accessToken).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"Token type is Bearer\", () => pm.expect(body.tokenType).to.eql(\"Bearer\"));",
                  "pm.test(\"Token expires in 60 minutes (3600s)\", () => pm.expect(body.expiresIn).to.eql(3600));",
                  "pm.test(\"Token looks like a JWT (3 parts)\", () => pm.expect(body.accessToken.split(\".\").length).to.eql(3));",
                  "pm.test(\"Password is not echoed back\", () => pm.expect(pm.response.text()).to.not.include(pm.environment.get(\"validPassword\")));",
                  "// Save the token so later requests can use it",
                  "pm.environment.set(\"accessToken\", body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC03 - Login email is case/space insensitive",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "The service trims and lower-cases the email, so ' USER@X.COM ' should still log in.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"  {{validEmailUpper}}  \",\n  \"password\": \"{{validPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns an access token\", () => pm.expect(pm.response.json().accessToken).to.be.a(\"string\").and.not.empty);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"validEmailUpper\", (pm.environment.get(\"validEmail\") || \"\").toUpperCase());"
                ]
              }
            }
          ]
        }
      ]
    },
