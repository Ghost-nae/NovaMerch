        },
        {
          "name": "TC17 - LOCKED account + WRONG password gives generic error",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "RISK: the code checks account status BEFORE the password, so a wrong password may reveal 'Account is locked'. That lets attackers find real accounts.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{lockedEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get(\"lockedEmail\")) { pm.test(\"SKIPPED - set lockedEmail in the environment\", () => {}); return; }",
                  "pm.test(\"Status code is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"No access token is returned\", () => { let b = {}; try { b = pm.response.json(); } catch (e) {} pm.expect(b.accessToken).to.be.undefined; });",
                  "pm.test(\"Does not reveal account status\", () => { const t = pm.response.text().toLowerCase(); [\"locked\",\"disabled\",\"verification\",\"not active\"].forEach(w => pm.expect(t).to.not.include(w)); });"
                ]
              }
            }
          ]
        },
